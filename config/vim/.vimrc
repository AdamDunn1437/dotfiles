" ── dotfiles vim/.vimrc ────────────────────────────────────────
" Symlinked via install.sh

set nocompatible

set number
set relativenumber
set tabstop=2
set shiftwidth=2
set expandtab
set noswapfile
set undofile
set ignorecase
set smartcase
set termguicolors
set incsearch
set hlsearch
set scrolloff=8
set showcmd
set wildmenu
set ruler
set laststatus=2

filetype plugin indent on
syntax on

colo torte
